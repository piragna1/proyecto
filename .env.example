DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
SUPERADMIN_EMAIL=
# Entrecomillar el valor: sin comillas, dotenv trata el "#" como inicio
# de comentario y trunca la clave (ej. "SuperAdmin#26" -> "SuperAdmin").
SUPERADMIN_PASSWORD=
JWT_SECRET=
# Notificaciones de turno por WhatsApp vía Green API (número personal vinculado
# por QR en el panel; plan Developer gratuito). Pegar los tres valores que se
# muestran en "Instance parameters" de la Consola (apiUrl, idInstance,
# apiTokenInstance). Envío de texto libre, sin plantillas.
NOTIFICACIONES_ACTIVO=false
GREEN_API_URL=
GREEN_API_ID=
GREEN_API_TOKEN=
# Proveedor de WhatsApp: 'greenapi' (REST, usa GREEN_API_*) o 'baileys'
# (conexión directa sin límites de chats; se vincula una sola vez con un código
# de emparejamiento o QR en la consola del backend).
WHATSAPP_PROVEEDOR=greenapi
# Teléfono sender (solo dígitos, internacional sin +): habilita la vinculación
# de Baileys por código de emparejamiento, sin cámara y sin QR. Vacío = QR.
WHATSAPP_SENDER_PHONE=
# Carpeta de sesión de Baileys (dejar vacía: %LOCALAPPDATA%\turnera\baileys-sesion).
BAILEYS_SESION_DIR=
# Lista blanca del demo: solo envía WhatsApp hacia estos números normalizados
# (separados por coma). Vacía = enviar a todos (comportamiento de producción).
WHATSAPP_WHITELIST=
PAIS_CODE=54
UBICACION_NEGOCIO=Dirección del local (placeholder)